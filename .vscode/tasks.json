{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "NuraAI production build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"check"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Install NuraAI dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Refresh latest minimal dependencies",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"npm install --save-exact --workspace apps/api fastify@latest zod@latest; npm install --save-dev --save-exact --workspace apps/api @types/node@latest tsx@latest typescript@latest vitest@latest; npm install --save-exact --workspace apps/web react@latest react-dom@latest; npm install --save-dev --save-exact --workspace apps/web @types/react@latest @types/react-dom@latest @vitejs/plugin-react@latest typescript@latest vite@latest"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Oxlint and Oxfmt",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--save-dev",
				"--save-exact",
				"oxlint@latest",
				"oxfmt@latest"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate Oxlint Oxfmt production check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"check"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run NuraAI checks",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"check"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Review commit scope",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review commit diff",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit NuraAI changes",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"git add -A; git commit -m \"chore: adopt oxlint and oxfmt\""
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage NuraAI changes",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit task cleanup",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}