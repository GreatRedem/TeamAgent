{
    "name": "nuraai",
    "private": true,
    "type": "module",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "concurrently -k -n api,web -c blue,magenta npm:dev:api npm:dev:web",
        "dev:api": "npm --workspace backend run dev",
        "dev:web": "npm --workspace frontend run dev",
        "build": "npm run build:api && npm run build:web",
        "build:api": "npm --workspace backend run build",
        "build:web": "npm --workspace frontend run build",
        "typecheck": "npm --workspace frontend run typecheck",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check",
        "service:stop": "bash scripts/service-stop.sh",
        "service:start": "bash scripts/service-start.sh",
        "service:status": "bash scripts/service-status.sh",
        "service:restart": "bash scripts/service-restart.sh",
        "service:install": "bash scripts/service-install.sh",
        "service:uninstall": "bash scripts/service-uninstall.sh",
        "service:deploy": "npm run build:api && npm run service:restart"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.0",
        "concurrently": "^10.0.5",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0"
    }
}
