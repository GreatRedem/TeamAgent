{
  "name": "nuraai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "start:api": "node apps/api/production.mjs api",
    "start:worker": "node apps/api/production.mjs worker",
    "config:production": "node apps/api/production.mjs config",
    "db:migrate:production": "node apps/api/production.mjs migrate",
    "smoke:release": "npm --workspace apps/api run smoke:release",
    "test:deploy": "node --test deploy/templates.test.mjs",
    "test:observability": "node --test deploy/observability.test.mjs",
    "release:check": "npm run check && npm run test:deploy && npm run test:observability && npm run test && npm run smoke:release",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck:api && npm run typecheck:web && npm run build",
    "test": "npm --workspace apps/api run test && npm --workspace apps/web run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  }
}
