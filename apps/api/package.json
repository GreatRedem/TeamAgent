{
  "name": "@nuraai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "start": "node dist/index.js",
    "start:production": "node --env-file=.env.production dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:worker:production": "node --env-file=.env.production dist/worker.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.4",
    "pg": "8.16.3",
    "viem": "^2.56.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pg": "8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
