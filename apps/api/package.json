{
  "name": "@nuraai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "start": "node production.mjs api",
    "start:production": "node production.mjs api",
    "start:worker": "node production.mjs worker",
    "start:worker:production": "node production.mjs worker",
    "config:production": "node production.mjs config",
    "test": "vitest run && node --test production.test.mjs",
    "smoke:release": "node smoke-release.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:production": "node production.mjs migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.4",
    "pg": "8.16.3",
    "viem": "^2.56.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pg": "8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
