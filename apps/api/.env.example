# Environment contract for the NuraAI API.
# See README.md for production commands and settings not yet wired.
# src/config.ts validates required fields and supported value syntax at startup.
#
# Dev commands (dev, db:migrate) load apps/api/.env when present; production
# entries, builds, and tests never auto-load a file — pass an explicit
# --env-file. Never commit real values.

# Runtime
NODE_ENV=development
HOST=127.0.0.1                 # bind to loopback; nginx is the only ingress
PORT=3000

# The proxy's address or subnet, NEVER `true`.
# `true` makes the app trust any X-Forwarded-For it receives, which lets a
# client that can reach the service directly spoof its IP into the audit log.
TRUST_PROXY=127.0.0.1

# Database -- PostgreSQL only. There is no dialect switch.
DATABASE_URL=postgres://user:password@localhost:5432/nuraai
DB_POOL_MAX=20                 # size with the worker fleet in mind; the queue shares this pool

# Auth -- see docs/20-authentication.md
JWT_SECRET=                    # 32+ random bytes; rotating it invalidates every token
JWT_ACCESS_TTL=15m
REFRESH_TTL=30d
SIWE_DOMAIN=nurachain.net      # MUST equal the browser origin exactly
SIWE_URI=https://nurachain.net
SIWE_CHAIN_ID=1020
EVM_RPC_URL=https://rpc.nurachain.net   # required for EIP-1271; fails closed on error

# Queue -- see docs/23-job-queue.md
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_LEASE_SECONDS=600        # longer than the slowest agent run, or it reruns
QUEUE_MAX_ATTEMPTS=5

# Jobs-table retention (docs/23 Cleanup): succeeded rows deleted after the
# short retention, dead/failed kept longer as diagnostics. Cleanup runs as
# a scheduled job in the queue itself.
JOBS_SUCCEEDED_RETENTION_HOURS=24
JOBS_FAILED_RETENTION_DAYS=14
JOBS_CLEANUP_CRON=17 3 * * *
# Hourly token rollup per team/agent/model into cost_rollups (docs/22 Cost).
JOBS_COST_ROLLUP_CRON=23 * * * *

# Observability -- see docs/22-observability.md
LOG_LEVEL=info

# Approvals -- see docs/17-threat-model.md C5
APPROVAL_TTL_SECONDS=3600      # an expired approval is a denial
APPROVAL_NOTIFY_CHANNEL=       # UNDECIDED: email cannot be assumed, see docs/20

# Model gateway -- single OpenAI-compatible provider for the MVP.
# Optional: deployments that never start agent runs do not need it.
MODEL_BASE_URL=                # e.g. https://api.openai.com/v1
MODEL_API_KEY=                 # never commit a real value
MODEL_TIMEOUT_MS=60000
