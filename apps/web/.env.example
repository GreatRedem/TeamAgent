# Environment contract for the NuraAI console (build-time only).
# See docs/19-tech-stack.md. Every value here is public by construction:
# it is inlined into the JS bundle, so no secret may ever live in this file.

# Leave empty for same-origin, which is the documented deployment: nginx
# serves this build and routes the API prefixes to the service. Only a split
# deployment sets it, and then to the proxy origin, never an API address.
VITE_API_BASE_URL=
