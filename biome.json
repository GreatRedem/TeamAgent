{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "plugins": [
        {
            "path": "./lint/no-raw-html.grit",
            "includes": ["**/frontend/src/**", "!**/frontend/src/ui/**"]
        }
    ],
    "files": {
        "includes": ["**", "!!**/dist", "!!**/dist-*", "!!**/.dist-*", "!.claude/skills"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            }
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": true
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
