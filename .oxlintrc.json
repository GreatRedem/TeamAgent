{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "unicorn",
        "oxc"
    ],
    "categories": {
        "correctness": "warn"
    },
    "env": {
        "node": true,
        "es2024": true
    },
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**"
    ],
    "rules": {
        "no-console": "warn",
        "typescript/no-explicit-any": "error"
    },
    "overrides": [
        {
            "files": [
                "frontend/**/*.{ts,tsx}"
            ],
            "plugins": [
                "react",
                "jsx-a11y"
            ],
            "env": {
                "browser": true,
                "es2024": true
            },
            "rules": {
                "react/rules-of-hooks": "error",
                "react/exhaustive-deps": "warn",
                "react/jsx-key": "error",
                "no-console": "warn"
            }
        }
    ]
}
