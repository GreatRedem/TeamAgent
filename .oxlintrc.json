{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "unicorn",
        "oxc"
    ],
    "categories":
    {
        "correctness": "warn"
    },
    "env":
    {
        "node": true,
        "es2024": true
    },
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**"
    ],
    "rules":
    {
        "no-console": "warn",
        "typescript/no-explicit-any": "error"
    }
}
